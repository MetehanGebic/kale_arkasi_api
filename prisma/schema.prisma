generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Club {
  id             String   @id @default(uuid())
  name           String   @unique
  slug           String   @unique
  primaryColor   String
  secondaryColor String
  logoUrl        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users          User[]

  // Prisma'ya veritabanındaki "clubs" tablosunu kullanmasını söyler
  @@map("clubs") 
}

model User {
  id                  String     @id @default(uuid())
  username            String     @unique
  email               String     @unique
  password            String     @default("")
  teaBalance          Int        @default(0) // Çay Bakiyesi
  lastDailyTeaClaimAt DateTime?  // Günlük bedava çayı son alma zamanı
  status              String     @default("ACTIVE")
  
  favoriteClubId      String
  favoriteClub        Club       @relation(fields: [favoriteClubId], references: [id])
  
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  completedTasks      UserTask[]

  // Prisma'ya veritabanındaki "users" tablosunu kullanmasını söyler
  @@map("users") 
}

model Task {
  id          String     @id @default(uuid())
  title       String     
  description String?    
  rewardTea   Int        
  actionType  String     @unique 
  isActive    Boolean    @default(true)
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userProgress UserTask[]

  @@map("tasks")
}

model UserTask {
  id          String   @id @default(uuid())
  userId      String
  taskId      String
  completedAt DateTime @default(now())
  dateKey     String   

  user        User     @relation(fields: [userId], references: [id])
  task        Task     @relation(fields: [taskId], references: [id])

  @@unique([userId, taskId, dateKey])
  @@map("user_tasks")
}